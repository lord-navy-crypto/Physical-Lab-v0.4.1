{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Physical Lab",
  "version": "0.5.0",
  "identifier": "com.lordnavy.physicallab",
  "build": {
    "beforeDevCommand": "python3 scripts/prepare.py",
    "beforeBuildCommand": "python3 scripts/prepare.py",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Physical Lab",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; frame-src http://127.0.0.1:*; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "resources/modules.json": "modules.json",
      "resources/safe_engine_server.py": "safe_engine_server.py",
      "resources/dependencies.json": "dependencies.json",
      "resources/ui/sitecustomize.py": "ui/sitecustomize.py",
      "resources/ui/physical_lab_advanced.py": "ui/physical_lab_advanced.py"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 220
        }
      }
    }
  }
}
